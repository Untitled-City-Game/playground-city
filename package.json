{
	"name": "parcel-react-client-starter",
	"private": true,
	"version": "0.1.1",
	"scripts": {
		"sass": "sass src/styles/interface.scss src/styles/interface.css",
		"dev": "dotenvx run -f .env.development -- vite serve src",
		"deploy": "dotenvx run -f .env -- npm run vite-build && firebase deploy --project=prod && npm run deploy-server",
		"stage": "dotenvx run -f .env.staging -- npm run vite-build && firebase deploy && npm run stage-server",
		"vite-build": "vite build src --outDir ../dist --assetsDir static",
		"deploy-server": "./scripts/deploy.sh prod",
		"stage-server": "./scripts/deploy.sh staging",
		"serve": "NODE_OPTIONS='--max-old-space-size=512' tsx --env-file .env.development server/server.ts",
		"build-server": "esbuild server/server.ts --bundle --platform=node --outfile=build/server.js --packages=external",
		"start-dev-server": "node --max-old-space-size=512 --env-file=.env.development build/server.js",
		"serve-dev": "npm run build-server && npm run start-dev-server",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@dotenvx/dotenvx": "^1.51.1",
		"@mantine/core": "^7.17.2",
		"@mantine/form": "^7.17.2",
		"@mantine/hooks": "^7.17.2",
		"@tmcw/togeojson": "^7.0.0",
		"@turf/turf": "^7.2.0",
		"@types/file-type": "^10.6.0",
		"@types/lodash": "^4.17.16",
		"@types/point-in-polygon": "^1.1.5",
		"@types/polylabel": "^1.1.3",
		"@vis.gl/react-google-maps": "^1.5.2",
		"boardgame.io": "^0.50.2",
		"csvjson-csv2json": "^5.0.6",
		"esbuild": "^0.25.12",
		"firebase": "^11.5.0",
		"load-esm": "^1.0.3",
		"lodash": "^4.17.21",
		"node-persist": "^4.0.4",
		"point-in-polygon": "^1.1.0",
		"polylabel": "^2.0.1",
		"react": "^19.0.0",
		"react-countdown": "^2.3.6",
		"react-device-detect": "^2.2.3",
		"react-dom": "^19.0.0",
		"react-error-boundary": "^5.0.0",
		"react-geolocated": "^4.3.0",
		"react-icons": "^5.5.0",
		"react-markdown": "^10.1.0",
		"react-player": "^2.16.0",
		"react-router": "^7.4.0",
		"simple-mime": "^0.1.0",
		"socket.io": "^4.8.1",
		"typescript": "^5.8.2",
		"xmldom": "^0.6.0"
	},
	"devDependencies": {
		"@types/geojson": "^7946.0.16",
		"@types/node": "^20.0.0",
		"@types/react": "^19.0.12",
		"@types/react-dom": "^19.0.4",
		"@types/xmldom": "^0.1.34",
		"@vitejs/plugin-react-swc": "^4.2.2",
		"buffer": "^6.0.3",
		"sass-embedded": "^1.100.0",
		"tsx": "^4.20.3",
		"vite": "^7.2.4"
	}
}
